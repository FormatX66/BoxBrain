RewriteEngine On

# Shared-host-safe front controller routing. Preserve the original REQUEST_URI and
# route directly to concrete handlers instead of depending on PATH_INFO support.
RewriteRule ^dashboard/?$ dashboard.html [L]
RewriteRule ^voice-status/?$ voice-status.php [L,QSA]
RewriteRule ^voice-status\.txt$ voice-status.php [L,QSA]
RewriteRule ^voice-status\.json$ voice-status.php?format=json [L,QSA]
RewriteRule ^status$ index.php [L,QSA]
RewriteRule ^nodes$ index.php [L,QSA]
RewriteRule ^events$ index.php [L,QSA]
RewriteRule ^work/status$ work-status.php [L,QSA]
RewriteRule ^work/(lease|result)$ index.php [L,QSA]
RewriteRule ^uaf$ index.php [L,QSA]

<FilesMatch "^(?:\.|state)">
  Require all denied
</FilesMatch>
