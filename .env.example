BOXBRAIN_ENVIRONMENT=development
BOXBRAIN_HOST=127.0.0.1
BOXBRAIN_PORT=8000
# Generate a unique value with at least 32 characters. Never commit the value.
BOXBRAIN_API_TOKEN=
BOXBRAIN_ALLOWED_HOSTS=127.0.0.1,localhost
BOXBRAIN_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://localhost:8080,https://127.0.0.1:8080
BOXBRAIN_PLUGIN_DIR=../plugins
BOXBRAIN_DATA_DIR=./data

# Add provider credentials only in a local .env file. Never commit secrets.
# OPENAI_API_KEY=
