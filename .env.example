BOXBRAIN_ENVIRONMENT=development
BOXBRAIN_HOST=127.0.0.1
BOXBRAIN_PORT=8000
# Generate a unique value with at least 32 characters. Never commit the value.
BOXBRAIN_API_TOKEN=
BOXBRAIN_ALLOWED_HOSTS=127.0.0.1,localhost
BOXBRAIN_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://localhost:8080,https://127.0.0.1:8080
BOXBRAIN_PLUGIN_DIR=../plugins
BOXBRAIN_OBSERVER_PLUGIN_ID=boxbrain.windows-sandbox-observer
BOXBRAIN_OBSERVATION_POLICY=../policies/observation.json
BOXBRAIN_DATA_DIR=./data
BOXBRAIN_AGENT_RUNTIME_ENABLED=true
BOXBRAIN_AGENT_MODEL=gpt-5.6-sol
BOXBRAIN_AGENT_MAX_OUTPUT_TOKENS=1800
BOXBRAIN_GITHUB_COPILOT_OFFLOAD_ENABLED=false
BOXBRAIN_GITHUB_COPILOT_ALLOWED_ROOTS=
BOXBRAIN_GITHUB_COPILOT_TIMEOUT_SECONDS=120
BOXBRAIN_GITHUB_COPILOT_MAX_FILES=100
BOXBRAIN_GITHUB_COPILOT_MAX_FILE_BYTES=32768
BOXBRAIN_GITHUB_COPILOT_MAX_CONTENT_BYTES=131072
BOXBRAIN_GITHUB_COPILOT_MAX_OUTPUT_BYTES=65536

# Add provider credentials only in a local .env file. Never commit secrets.
# OPENAI_API_KEY=
