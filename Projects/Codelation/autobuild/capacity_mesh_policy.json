{
  "schema": "aurum-capacity-mesh-policy-v1",
  "revision": "2026-08-20-distributed-build-v1",
  "principles": [
    "local-first",
    "evidence-first",
    "auto-select-most-efficient-proven-path",
    "user-need-not-know-better-path-exists",
    "preserve-user-intent",
    "never-trade-safety-or-verification-for-speed",
    "no-quota-sharding",
    "no-arbitrary-remote-command-execution",
    "fan-out-only-for-independent-work",
    "fan-in-only-from-verified-evidence",
    "do-not-idle-when-authorized-deterministic-work-exists"
  ],
  "optimization": {
    "default_mode": "automatic",
    "discover_better_paths_without_user_prompt": true,
    "adopt_better_path_when": "verified-equivalent-or-better-and-reversible",
    "objective_order": [
      "correctness",
      "safety",
      "user-intent",
      "verification-strength",
      "latency",
      "compute-efficiency",
      "cost"
    ],
    "require_user_decision_when": [
      "user-intent-would-change",
      "irreversible-or-destructive-change",
      "new-external-cost",
      "new-permission-or-credential-scope",
      "privacy-boundary-change"
    ],
    "forbidden_shortcuts": [
      "weaken-verification",
      "skip-required-recovery",
      "silently-destructive-change",
      "quota-evasion",
      "unverified-promotion"
    ]
  },
  "limits": {
    "max_parallel_hosted_lanes": 18,
    "reserve_hosted_slots": 2,
    "max_speculative_paths_per_gap": 18,
    "minimum_verifier_lanes": 4,
    "target_slot_utilization": 0.90,
    "maximum_duplicate_work_fraction": 0.05,
    "maximum_queue_minutes": 5
  },
  "work_classes": {
    "container-build": {
      "architectures": ["x86_64"],
      "execution_environment": "docker-buildkit",
      "artifact_role": "immutable-builder-image",
      "compatibility_identity": ["builder-definition", "base-image-digest", "architecture"]
    },
    "cached-build": {
      "architectures": ["x86_64", "arm64"],
      "execution_environment": "prepared-container",
      "artifact_role": "content-addressed-build-output",
      "compatibility_identity": ["source-or-relevant-source-hash", "architecture", "toolchain-image-digest", "build-configuration", "dependency-definition"]
    },
    "unit-test-shard": {
      "architectures": ["x86_64", "arm64"],
      "execution_environment": "github-hosted-runner",
      "artifact_role": "test-evidence"
    },
    "verification-shard": {
      "architectures": ["x86_64", "arm64"],
      "execution_environment": "github-hosted-runner",
      "artifact_role": "verification-evidence"
    },
    "vm-topology-verification": {
      "architectures": ["x86_64"],
      "execution_environment": "qemu-uefi-tcg",
      "artifact_role": "topology-specific-verification-evidence"
    },
    "artifact-convergence": {
      "architectures": ["multi-architecture"],
      "execution_environment": "ephemeral-fan-in",
      "artifact_role": "single-verified-promotion-path"
    }
  },
  "physical_consumers": {
    "Hopper": {
      "architecture": "x86_64",
      "role": "final-physical-evidence-and-generation-propagation",
      "accepts": "verified-promoted-artifacts-only",
      "speculative_compilation": false
    },
    "BBPI4": {
      "architecture": "arm64",
      "role": "physical-arm-seed-and-node-validation",
      "accepts": "architecture-distinguished-verified-evidence",
      "speculative_compilation": false,
      "blocks_hopper": false
    }
  },
