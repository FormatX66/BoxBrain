{
  "schema": "aurum-capacity-mesh-policy-v1",
  "revision": "2026-08-20",
  "principles": [
    "local-first",
    "evidence-first",
    "auto-select-most-efficient-proven-path",
    "user-need-not-know-better-path-exists",
    "preserve-user-intent",
    "never-trade-safety-or-verification-for-speed",
    "no-quota-sharding",
    "no-arbitrary-remote-command-execution",
    "fan-out-only-for-independent-work",
    "fan-in-only-from-verified-evidence",
    "do-not-idle-when-authorized-deterministic-work-exists"
  ],
  "optimization": {
    "default_mode": "automatic",
    "discover_better_paths_without_user_prompt": true,
    "adopt_better_path_when": "verified-equivalent-or-better-and-reversible",
    "objective_order": [
      "correctness",
      "safety",
      "user-intent",
      "verification-strength",
      "latency",
      "compute-efficiency",
      "cost"
    ],
    "require_user_decision_when": [
      "user-intent-would-change",
      "irreversible-or-destructive-change",
      "new-external-cost",
      "new-permission-or-credential-scope",
      "privacy-boundary-change"
    ],
    "forbidden_shortcuts": [
      "weaken-verification",
      "skip-required-recovery",
      "silently-destructive-change",
      "quota-evasion",
      "unverified-promotion"
    ]
  },
  "limits": {
    "max_parallel_hosted_lanes": 18,
    "reserve_hosted_slots": 2,
    "max_speculative_paths_per_gap": 18,
    "minimum_verifier_lanes": 4,
    "target_slot_utilization": 0.90,
    "maximum_duplicate_work_fraction": 0.05,
    "maximum_queue_minutes": 5
  },
  "nodes": [
    {
      "name": "github-hosted-x64",
      "kind": "github-actions",
      "capabilities": ["build", "git", "network", "python", "test", "x86_64"],
      "capacity": 16,
      "ephemeral": true,
      "authority": "repository"
    },
    {
      "name": "github-hosted-arm64",
      "kind": "github-actions",
      "capabilities": ["build", "git", "network", "python", "test", "arm64"],
      "capacity": 2,
      "ephemeral": true,
      "authority": "repository"
    },
    {
      "name": "gpt-python",
      "kind": "gpt-python",
      "capabilities": ["analysis", "comparison", "python", "small-simulation", "verification"],
      "capacity": 1,
      "ephemeral": true,
      "network": false,
      "preferred_for": ["bounded-analysis", "evidence-comparison", "small-deterministic-calculation"],
      "avoid_for": ["long-build", "persistent-daemon", "large-artifact-storage"]
    },
    {
      "name": "windows-authorized-node",
      "kind": "self-hosted",
      "capabilities": ["physical-network", "windows", "x86_64"],
      "capacity": 1,
      "availability": "fresh-heartbeat-required",
      "authority": "explicit-local-lane"
    },
    {
      "name": "BBPI4",
      "kind": "physical-node",
      "capabilities": ["arm64", "physical-io", "physical-network"],
      "capacity": 1,
      "availability": "fresh-heartbeat-required",
      "authority": "explicit-local-lane"
    }
  ],
