  "physical_hold_behavior": "fork-and-continue",
  "exploration_branches": {
    "safe": "aurum/explore-safe-v0.01",
    "adventurous": "aurum/explore-adventurous-v0.01",
    "stress": "aurum/stress-v0.01"
  },
  "branch_reconciliation": {
    "fast_forward_from_trunk_when_possible": true,
    "force_reset_divergent_branch": false,
    "automatic_experimental_merge_to_trunk": false,
    "physical_proof_required_for_physical_acceptance": true
  },
  "reversible": true
