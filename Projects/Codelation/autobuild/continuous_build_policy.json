  "principle": "continuous-progress-across-independent-and-exploratory-fronts",
  "rules": [
    "keep-building-while-authorized-deterministic-work-exists",
    "a-blocked-front-must-not-globally-stall-independent-fronts",
    "physical-prerequisites-block-only-the-dependent-physical-front",
    "physical-hold-is-a-fork-point-not-a-global-stop",
    "preserve-held-physical-checkpoint-while-independent-capability-branches-advance",
    "maintain-durable-safe-adventurous-and-stress-exploration-branches",
    "prefer-event-driven-progress-with-a-periodic-watchdog",
    "retest-unchanged-verified-work-for-regression-stress-flake-and-differential-detection",
    "fan-out-independent-work-with-bounded-parallelism",
    "fan-in-only-from-verified-evidence",
    "experimental-virtual-results-must-never-be-promoted-as-physical-proof",
    "promote-only-independently-verified-improvements-back-to-trunk",
    "use-hosted-compute-for-build-test-simulation-stress-and-comparison",
    "use-physical-nodes-for-hardware-observation-materialization-and-final-acceptance",
    "reconcile-exploration-branches-forward-from-current-verified-trunk-when-fast-forward-safe",
    "preserve-divergent-experimental-branches-until-they-are-verified-rejected-or-converged"
