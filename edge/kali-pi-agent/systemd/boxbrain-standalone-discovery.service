[Unit]
Description=BoxBrain bounded standalone trusted-LAN discovery
Documentation=file:/opt/boxbrain/README.md
Wants=network-online.target
After=network-online.target boxbrain-network-mode.service

[Service]
Type=oneshot
User=boxbrain
Group=boxbrain
Environment=PYTHONPATH=/opt/boxbrain/src
EnvironmentFile=-/etc/boxbrain/boxbrain.env
ExecStart=/usr/bin/python3 -m boxbrain.standalone_discovery
TimeoutStartSec=90s
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/boxbrain
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
