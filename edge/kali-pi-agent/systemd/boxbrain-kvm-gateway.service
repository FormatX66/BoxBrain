[Unit]
Description=BoxBrain Pi-only physical KVM gateway
Requires=boxbrain.service
Wants=boxbrain-hid-kvm.service boxbrain-kvm-video.service
After=boxbrain.service boxbrain-hid-kvm.service boxbrain-kvm-video.service

[Service]
Type=simple
User=boxbrain
Group=boxbrain
Environment=PYTHONPATH=/opt/boxbrain/src
ExecStart=/usr/bin/python3 -m boxbrain.console_gateway --bind 10.12.194.1 --port 8791 --directory /opt/boxbrain/pi-console --backend http://127.0.0.1:8787 --video-backend http://127.0.0.1:8082/stream --kvm-only
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
