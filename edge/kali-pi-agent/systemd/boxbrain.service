[Unit]
Description=BoxBrain Kali Pi edge agent
Documentation=file:/opt/boxbrain/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=boxbrain
Group=boxbrain
WorkingDirectory=/var/lib/boxbrain
RuntimeDirectory=boxbrain
RuntimeDirectoryMode=0770
Environment=PYTHONPATH=/opt/boxbrain/src
EnvironmentFile=-/etc/boxbrain/boxbrain.env
ExecStart=/usr/bin/python3 -m boxbrain.server
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/boxbrain
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
